                    "$toggle_name": "network_center_pages",
                    "$card_tab_index": 1,
                    "$card_selected_tab": 0,
                    "$card_icon": "textures/ui/network_center/gains",
                    "$card_icon_size": [
                        16,
                        16
                    ],
                    "$card_icon_color": [
                        1,
                        1,
                        1
                    ],
                    "$card_tooltip": "ui.ascendant:network.gains",
                    "$toggle_tts_name": "ui.ascendant:network.gains",
                    "$card_unchecked_texture": "textures/ui/button_card/button_light_blue",
                    "$card_checked_texture": "textures/ui/button_card/button_light_blue_pressed",
                    "$card_unchecked_hover_texture": "textures/ui/button_card/button_light_blue_hover",
                    "$card_checked_hover_texture": "textures/ui/button_card/button_light_blue_pressed_hover"
                }
            },
            {
                "losses_tab@at_common.card_tab": {
                    "$toggle_name": "network_center_pages",
                    "$card_tab_index": 2,
                    "$card_selected_tab": 0,
                    "$card_icon": "textures/ui/network_center/losses",
                    "$card_icon_size": [
                        16,
                        16
                    ],
                    "$card_icon_color": [
                        1,
                        1,
                        1
                    ],
                    "$card_tooltip": "ui.ascendant:network.losses",
                    "$toggle_tts_name": "ui.ascendant:network.losses",
                    "$card_unchecked_texture": "textures/ui/button_card/button_light_blue",
                    "$card_checked_texture": "textures/ui/button_card/button_light_blue_pressed",
                    "$card_unchecked_hover_texture": "textures/ui/button_card/button_light_blue_hover",
                    "$card_checked_hover_texture": "textures/ui/button_card/button_light_blue_pressed_hover"
                }
            },
            {
                "capacity_tab@at_common.card_tab": {
                    "$toggle_name": "network_center_pages",
                    "$card_tab_index": 3,
                    "$card_selected_tab": 0,
                    "$card_icon": "textures/ui/network_center/capacity",
                    "$card_icon_size": [
                        16,
                        16
                    ],
                    "$card_icon_color": [
                        1,
                        1,
                        1
                    ],
                    "$card_tooltip": "ui.ascendant:network.capacity",
                    "$toggle_tts_name": "ui.ascendant:network.capacity",
                    "$card_unchecked_texture": "textures/ui/button_card/button_light_blue",
                    "$card_checked_texture": "textures/ui/button_card/button_light_blue_pressed",
                    "$card_unchecked_hover_texture": "textures/ui/button_card/button_light_blue_hover",
                    "$card_checked_hover_texture": "textures/ui/button_card/button_light_blue_pressed_hover"
                }
            }
        ]
    },
    "view_top_bar@at_common.button_card": {
        "$card_offset": [
            0,
            4
        ],
        "$card_buttons_ref": "network_center.button_card_buttons",
        "$card_selected_tab": 0,
        "$card_size": [
            "100%c",
            27
        ],
        "$card_content_offset": [
            0,
            4
        ]
    },
    "overview_content@network_center.compact_info": {
        "$label_index": 0,
        "$text_scale": 0.7,
        "$text_color": [
            0.82,
            0.87,
            0.91
        ]
    },
    "gains_content@network_center.compact_info": {
        "$label_index": 1,
        "$text_scale": 0.7,
        "$text_color": [
            0.82,
            0.87,
            0.91
        ]
    },
    "losses_content@network_center.compact_info": {
        "$label_index": 2,
        "$text_scale": 0.7,
        "$text_color": [
            0.82,
            0.87,
            0.91
        ]
    },
    "capacity_content@network_center.compact_info": {
        "$label_index": 3,
        "$text_scale": 0.7,
        "$text_color": [
            0.82,
            0.87,
            0.91
        ]
    },
    "compact_info": {
        "type": "stack_panel",
        "orientation": "vertical",
        "anchor_from": "top_left",
        "anchor_to": "top_left",
        "size": [
            "100%",
            "default"
        ],
        "$label_index|default": 1,
        "$text_scale|default": 0.55,
        "$text_color|default": [
            0,
            1,
            0
        ],
        "controls": [
            {
                "label_collection": {
                    "type": "collection_panel",
                    "collection_name": "container_items",
                    "anchor_from": "top_left",
                    "anchor_to": "top_left",
                    "size": [
                        "100%",
                        "100%c"
                    ],
                    "controls": [
                        {
                            "label@uc.text_label": {
                                "collection_index": "$label_index",
                                "anchor_from": "top_left",
                                "anchor_to": "top_left",
                                "size": [
                                    "100% - 8px",
                                    "100%c"
                                ],
                                "offset": [
                                    4,
                                    0
                                ],
                                "$text_scale": "$text_scale",
                                "layer": 1,
                                "controls": [
                                    {
                                        "label_v1@uc._text_label_v1": {
                                            "anchor_from": "top_left",
                                            "anchor_to": "top_left",
                                            "size": [
                                                "100%",
                                                "default"
                                            ],
                                            "text_alignment": "left",
                                            "color": "$text_color"
                                        }
                                    },
                                    {
                                        "label_v2@uc._text_label_v2": {
                                            "anchor_from": "top_left",
                                            "anchor_to": "top_left",
                                            "size": [
                                                "100%",
                                                "default"
                                            ],
                                            "text_alignment": "left",
                                            "color": "$text_color"
                                        }
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        ]
    },
    "page_button_label@common_buttons.new_ui_binding_button_label": {
        "anchor_from": "left_middle",
        "anchor_to": "left_middle",
        "offset": [
            6,
            0
        ]
    },
    "status_text": {
        "type": "collection_panel",
        "collection_name": "container_items",
        "size": [
            "100%",
            "100%"
