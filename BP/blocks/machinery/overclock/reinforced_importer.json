{
	"format_version": "1.21.100",
	"minecraft:block": {
		"description": {
			"identifier": "utilitycraft:reinforced_importer",
			"menu_category": {
				"category": "construction",
				"group": "dorios:itemGroup.name.pipes"
			},
			"states": {
				"utilitycraft:up": [false, true],
				"utilitycraft:down": [false, true],
				"utilitycraft:north": [false, true],
				"utilitycraft:south": [false, true],
				"utilitycraft:east": [false, true],
				"utilitycraft:west": [false, true]
			},
			"traits": {
				"minecraft:placement_position": {
					"enabled_states": [
						"minecraft:block_face"
					]
				}
			}
		},
		"components": {
			"utilitycraft:reinforced_importer": {
				"machine": {
					"fluid_rate": 4000
				}
			},
			"minecraft:geometry": {
				"identifier": "geometry.utilitycraft_reinforced_importer",
				"bone_visibility": {
					"up": "q.block_state('utilitycraft:up')",
					"down": "q.block_state('utilitycraft:down')",
					"north": "q.block_state('utilitycraft:north')",
					"south": "q.block_state('utilitycraft:south')",
					"east": "q.block_state('utilitycraft:east')",
					"west": "q.block_state('utilitycraft:west')"
				}
			},
			"minecraft:material_instances": {
				"*": {
					"texture": "utilitycraft_reinforced_cable",
					"render_method": "alpha_test"
				}
			},
			"minecraft:collision_box": {
				"origin": [0, 0, 0],
				"size": [0, 0, 0]
			},
			"minecraft:selection_box": {
				"origin": [-4, 4, -4],
				"size": [8, 8, 8]
			},
			"minecraft:tick": {
				"interval_range": [10, 10]
			},
			"minecraft:destructible_by_mining": {
				"seconds_to_destroy": 1
			},
			"minecraft:destructible_by_explosion": false,
			"tag:dorios:fluid": {},
			"tag:dorios:isTube": {},
			"tag:dorios:isImporter": {},
			"tag:dorios:color.default": {},
			"tag:minecraft:is_pickaxe_item_destructible": {}
		},
		"permutations": [
			{
				"condition": "q.block_state('minecraft:block_face') == 'up'",
				"components": {
					"minecraft:transformation": {
						"rotation": [-90, 0, 0]
					}
				}
			},
			{
				"condition": "q.block_state('minecraft:block_face') == 'down'",
				"components": {
					"minecraft:transformation": {
						"rotation": [90, 0, 0]
					}
				}
			},
			{
				"condition": "q.block_state('minecraft:block_face') == 'north'",
				"components": {
					"minecraft:transformation": {
						"rotation": [0, 180, 0]
					}
				}
			},
			{
				"condition": "q.block_state('minecraft:block_face') == 'south'",
				"components": {
					"minecraft:transformation": {
						"rotation": [0, 0, 0]
					}
				}
			},
			{
				"condition": "q.block_state('minecraft:block_face') == 'east'",
				"components": {
					"minecraft:transformation": {
						"rotation": [0, 90, 0]
					}
				}
			},
			{
				"condition": "q.block_state('minecraft:block_face') == 'west'",
				"components": {
					"minecraft:transformation": {
						"rotation": [0, -90, 0]
					}
				}
			}
		]
	}
}
