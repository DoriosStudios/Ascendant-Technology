{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "utilitycraft:watchling",
      "materials": {
        "default": "skeleton"
      },
      "textures": {
        "default": "textures/entity/mobs/watchling"
      },
      "geometry": {
        "default": "geometry.utilitycraft_watchling"
      },
      "scripts": {
        "pre_animation": [
          "variable.tcos0 = (Math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed / variable.gliding_speed_value) * 28.65;"
        ],
        "animate": [
          "move",
          "look_at_target_default",
          "bob",
          {
		"attack": "query.is_delayed_attacking || query.has_target"
          }
        ]
      },
      "animations": {
        "look_at_target_default": "animation.humanoid.look_at_target.default",
        "move": "animation.humanoid.move",
        "bob": "animation.humanoid.bob",
        "attack": "animation.utilitycraft_watchling.attack"
      },
      "render_controllers": [
        "controller.render.default"
      ],
      "spawn_egg": {
        "texture": "utilitycraft:watchling",
        "texture_index": 0
      }
    }
  }
}
