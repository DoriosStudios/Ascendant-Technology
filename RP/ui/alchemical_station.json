{
	"namespace": "alchemical_station",
	"button_card_buttons@at_core.button_card_row": {
		"controls": [
			{
				"alchemy_brewing_tab@at_common.card_tab": {
					"$toggle_name": "alchemy_pages",
					"$card_tab_index": 0,
					"$card_icon": "textures/ui/at_icons/brew",
					"$card_icon_size": [16, 16],
					"$card_tooltip": "ui.ascendant:alchemy.tab.brewing",
					"$toggle_tts_name": "ui.ascendant:alchemy.tab.brewing",
					"$card_unchecked_texture": "textures/ui/button_card/button_brown",
					"$card_checked_texture": "textures/ui/button_card/button_brown_pressed",
					"$card_unchecked_hover_texture": "textures/ui/button_card/button_brown_hover",
					"$card_checked_hover_texture": "textures/ui/button_card/button_brown_pressed_hover"
				}
			},
			{
				"alchemy_aplifying_tab@at_common.card_tab": {
					"$toggle_name": "alchemy_pages",
					"$card_tab_index": 1,
					"$card_icon": "textures/ui/at_icons/modify_potion",
					"$card_icon_size": [16, 16],
					"$card_tooltip": "ui.ascendant:alchemy.tab.upgrades",
					"$toggle_tts_name": "ui.ascendant:alchemy.tab.upgrades",
					"$card_unchecked_texture": "textures/ui/button_card/button_brown",
					"$card_checked_texture": "textures/ui/button_card/button_brown_pressed",
					"$card_unchecked_hover_texture": "textures/ui/button_card/button_brown_hover",
					"$card_checked_hover_texture": "textures/ui/button_card/button_brown_pressed_hover"
				}
			}
		]
	},
	"view_top_bar@at_common.button_card": {
		"$card_offset": [0, 4],
		"$card_buttons_ref": "alchemical_station.button_card_buttons",
		"$card_background_texture": "textures/ui/button_card/tab_top_brown"
	},
	"side_button_card_buttons@at_core.button_card_row": {
		"controls": [
			{
				"alchemy_display_tab@at_common.card_tab": {
					"$toggle_name": "alchemy_side_pages",
					"$card_tab_index": 0,
					"$card_icon": "textures/ui/at_icons/info",
					"$card_icon_size": [16, 16],
					"$card_tooltip": "ui.ascendant:alchemy.tab.display",
					"$toggle_tts_name": "ui.ascendant:alchemy.tab.display",
					"$card_unchecked_texture": "textures/ui/button_card/button_brown",
					"$card_checked_texture": "textures/ui/button_card/button_brown_pressed",
					"$card_unchecked_hover_texture": "textures/ui/button_card/button_brown_hover",
					"$card_checked_hover_texture": "textures/ui/button_card/button_brown_pressed_hover"
				}
			},
			{
				"alchemy_recipes_tab@at_common.card_tab": {
					"$toggle_name": "alchemy_side_pages",
					"$card_tab_index": 1,
					"$card_icon": "textures/ui/at_icons/recipe_book",
					"$card_icon_size": [16, 16],
					"$card_tooltip": "ui.ascendant:alchemy.tab.recipes",
					"$toggle_tts_name": "ui.ascendant:alchemy.tab.recipes",
					"$card_unchecked_texture": "textures/ui/button_card/button_brown",
					"$card_checked_texture": "textures/ui/button_card/button_brown_pressed",
					"$card_unchecked_hover_texture": "textures/ui/button_card/button_brown_hover",
					"$card_checked_hover_texture": "textures/ui/button_card/button_brown_pressed_hover"
				}
			},
			{
				"alchemy_progression_tab@at_common.card_tab": {
					"$toggle_name": "alchemy_side_pages",
					"$card_tab_index": 2,
					"$card_icon": "textures/ui/at_icons/progression",
					"$card_icon_size": [16, 16],
					"$card_tooltip": "ui.ascendant:alchemy.tab.progression",
					"$toggle_tts_name": "ui.ascendant:alchemy.tab.progression",
					"$card_unchecked_texture": "textures/ui/button_card/button_brown",
					"$card_checked_texture": "textures/ui/button_card/button_brown_pressed",
					"$card_unchecked_hover_texture": "textures/ui/button_card/button_brown_hover",
