{
    "format_version": "1.21.100",
    "minecraft:block": {
        "description": {
            "identifier": "utilitycraft:absolute_container",
            "menu_category": {
                "category": "items",
                "group": "minecraft:itemGroup.name.chest"
            },
            "traits": {
                "minecraft:placement_direction": {
                    "enabled_states": [
                        "minecraft:cardinal_direction"
                    ],
                    "y_rotation_offset": 180
                }
            },
            "states": {
                "utilitycraft:on": [false, true]
            }
        },
        "components": {
            "utilitycraft:absolute_container": {
                "entity": {
                    "id": "utilitycraft:storage_container",
                    "type": "machine",
                    "skip_machine_event": false,
                    "skip_inventory_event": false,
                    "input_type": "none",
                    "output_type": "none",
                    "inventory_size": 170,
                    "input_range": [0, 158],
                    "output_range": [159, 167]
                },
                "machine": {
                    "energy_cap": 25600000,
                    "energy_cost": 0,
                    "rate_speed_base": 25600000,
                    "fluid_cap": 25600000,
                    "fluid_rate": 25600000,
                    "upgrades": [],
                    "hidden_slots": []
                }
            },
            "minecraft:geometry": "geometry.utilitycraft_absolute_container",
            "minecraft:material_instances": {
                "*": {
                    "texture": "utilitycraft_absolute_container_off",
                    "render_method": "alpha_test"
                }
            },
            "minecraft:light_emission": 2,
            "minecraft:tick": { "interval_range": [2, 2] },
            "minecraft:destructible_by_mining": { "seconds_to_destroy": 12 },
            "minecraft:destructible_by_explosion": false,
            "tag:dorios:machine": {},
            "tag:dorios:energy": {},
            "tag:dorios:item": {},
            "tag:dorios:fluid": {},
            "tag:minecraft:is_pickaxe_item_destructible": {}
        },
        "permutations": [
            {
                "condition": "q.block_state('utilitycraft:on') == 1",
                "components": {
                    "minecraft:material_instances": {
                        "*": {
                            "texture": "utilitycraft_absolute_container_on",
                            "render_method": "alpha_test"
                        }
                    },
                    "minecraft:light_emission": 4
                }
            },
            {
                "condition": "q.block_state('minecraft:cardinal_direction') == 'north'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            0,
                            0,
                            0
                        ]
                    }
                }
            },
            {
                "condition": "q.block_state('minecraft:cardinal_direction') == 'south'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            0,
                            180,
                            0
                        ]
                    }
                }
            },
            {
                "condition": "q.block_state('minecraft:cardinal_direction') == 'east'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            0,
                            -90,
                            0
                        ]
                    }
                }
            },
            {
                "condition": "q.block_state('minecraft:cardinal_direction') == 'west'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            0,
                            90,
                            0
                        ]
                    }
                }
            }
        ]
    }
}
