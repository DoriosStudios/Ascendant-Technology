    "_tab_face": {
        "type": "panel",
        "size": [
            "100%",
            "100%"
        ],
        "$texture|default": "textures/ui/panels/background_panel_dark",
        "$alpha|default": 1,
        "controls": [
            {
                "background@at_core.surface": {
                    "alpha": "$alpha",
                    "layer": 0,
                    "$texture": "$texture"
                }
            },
            {
                "label": {
                    "type": "label",
                    "text": "$label",
                    "font_scale_factor": "$text_scale",
                    "color": "$text_color",
                    "text_alignment": "center",
                    "localize": true,
                    "layer": 1
                }
            },
            {
                "icon": {
                    "type": "image",
                    "texture": "$icon",
                    "size": "$icon_size",
                    "offset": "$icon_offset",
                    "color": "$icon_color",
                    "ignored": "($icon = '')",
                    "layer": 2
                }
            }
        ]
    },
    "_tab_checked@at_common._tab_face": {
        "$texture": "textures/ui/panels/background_panel_black",
        "$alpha": 0.95
    },
    "_tab_hover@at_common._tab_face": {
        "$texture": "textures/ui/panels/background_panel",
        "$alpha": 1
    },
    "_tab_checked_hover@at_common._tab_checked": {
        "$alpha": 1
    },
    "tab_button@at_core.toggle": {
        "$button_size|default": [
            36,
            20
        ],
        "size": "$button_size",
        "$tab_group|default": "tabs_group",
        "$tab_index|default": 0,
        "$selected_tab|default": 0,
        "$radio_toggle_group|default": true,
        "$toggle_name|default": "$tab_group",
        "$toggle_group_default_selected": "$selected_tab",
        "$toggle_group_forced_index": "$tab_index",
        "$unchecked_control|default": "at_common._tab_face",
        "$checked_control|default": "at_common._tab_checked",
        "$unchecked_hover_control|default": "at_common._tab_hover",
        "$checked_hover_control|default": "at_common._tab_checked_hover",
        "$unchecked_locked_control|default": "at_common._tab_face",
        "$checked_locked_control|default": "at_common._tab_checked",
        "$unchecked_locked_hover_control|default": "at_common._tab_hover",
        "$checked_locked_hover_control|default": "at_common._tab_checked_hover",
        "$label|default": "",
        "$text_scale|default": 0.6,
        "$text_color|default": [
            1,
            1,
            1
        ],
        "$icon|default": "",
        "$icon_size|default": [
            12,
            12
        ],
        "$icon_offset|default": [
            0,
            0
        ],
        "$icon_color|default": [
            1,
            1,
            1
        ]
    },
    "tab_content": {
        "type": "panel",
        "$tab_control|default": "",
        "bindings": [
            {
                "binding_type": "view",
                "source_control_name": "$tab_control",
                "source_property_name": "#toggle_state",
                "target_property_name": "#visible",
                "resolve_sibling_scope": true
            }
        ]
    },
    "toggle_unchecked": {
        "type": "panel",
        "$toggle_background_alpha|default": 1,
        "$toggle_icon_color|default": [1, 1, 1],
        "$toggle_show_focus|default": false,
        "controls": [
            {
                "background@at_core.surface": {
                    "$texture": "textures/ui/panels/background_panel_dark",
                    "alpha": "$toggle_background_alpha",
                    "layer": 0
                }
            },
            {
                "icon": {
                    "type": "image",
                    "texture": "textures/ui/plus",
                    "color": "$toggle_icon_color",
                    "size": [
                        8,
                        8
                    ],
                    "layer": 1
                }
            },
            {
                "focus@common.white_border_slot": { "layer": 2, "ignored": "(not $toggle_show_focus)" }
            }
        ]
    },
    "toggle_checked": {
        "type": "panel",
        "$toggle_background_alpha|default": 0.95,
        "$toggle_icon_color|default": [1, 1, 1],
        "$toggle_show_focus|default": false,
        "controls": [
            {
                "background@at_core.surface": {
                    "$texture": "textures/ui/panels/background_panel_black",
                    "alpha": "$toggle_background_alpha",
                    "layer": 0
                }
            },
            {
                "icon": {
                    "type": "image",
                    "texture": "textures/ui/minus",
                    "color": "$toggle_icon_color",
                    "size": [
                        8,
                        8
                    ],
                    "layer": 1
                }
            },
            {
                "focus@common.white_border_slot": { "layer": 2, "ignored": "(not $toggle_show_focus)" }
            }
        ]
    },
    "_toggle_unchecked_hover@at_common.toggle_unchecked": {
        "$toggle_show_focus": true
    },
    "_toggle_checked_hover@at_common.toggle_checked": {
        "$toggle_show_focus": true
    },
    "_toggle_unchecked_locked@at_common.toggle_unchecked": {
        "$toggle_background_alpha": 0.5,
        "$toggle_icon_color": [0.5, 0.5, 0.5]
    },
    "_toggle_checked_locked@at_common.toggle_checked": {
        "$toggle_background_alpha": 0.5,
        "$toggle_icon_color": [0.5, 0.5, 0.5]
    },
    "toggle_button@at_core.toggle": {
        "$unchecked_control|default": "at_common.toggle_unchecked",
        "$checked_control|default": "at_common.toggle_checked",
        "$unchecked_hover_control|default": "at_common._toggle_unchecked_hover",
        "$checked_hover_control|default": "at_common._toggle_checked_hover",
        "$unchecked_locked_control|default": "at_common._toggle_unchecked_locked",
        "$checked_locked_control|default": "at_common._toggle_checked_locked",
        "$unchecked_locked_hover_control|default": "at_common._toggle_unchecked_locked",
        "$checked_locked_hover_control|default": "at_common._toggle_checked_locked"
    },
    "section_label": {
        "type": "label",
        "$label_text|default": "",
        "$label_color|default": [
            1,
            1,
            1
        ],
        "text": "$label_text",
        "color": "$label_color",
        "font_scale_factor": 0.7,
        "localize": true
    },
    "machine_help_content": {
        "type": "stack_panel",
        "orientation": "vertical",
        "anchor_from": "top_left",
        "anchor_to": "top_left",
        "size": [
            "100%",
            "default"
        ],
        "controls": [
            {
                "description_label": {
                    "type": "label",
                    "text": "$info_description",
                    "localize": true,
                    "size": [
                        "100%",
                        "default"
                    ],
                    "font_scale_factor": 0.65,
                    "color": [0.9, 0.9, 0.9],
                    "text_alignment": "left"
                }
            },
            {
                "bottom_padding": {
                    "type": "panel",
                    "size": [
                        "100%",
                        4
                    ]
                }
            }
        ],
        "$info_description|default": ""
    },
    "machine_info_tab": {
        "$info_content|default": "uc.info_description_scroll_content",
        "type": "collection_panel",
        "anchor_from": "center",
        "anchor_to": "center",
        "size": [
