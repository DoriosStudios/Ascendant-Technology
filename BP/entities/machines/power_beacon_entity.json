                "min": 1,
                "value": 1
            },
            "minecraft:knockback_resistance": {
                "value": 1000,
                "max": 1000
            },
            "minecraft:collision_box": {
                "height": 0.5,
                "width": 1
            },
            "minecraft:fire_immune": true,
            "minecraft:inventory": {
                "inventory_size": 3,
                "container_type": "container"
            },
            "minecraft:environment_sensor": {
                "triggers": {
                    "filters": {
                        "test": "has_tag",
