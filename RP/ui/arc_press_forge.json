{
    "namespace": "arc_press_forge",
    "arc_press_forge_top": {
        "type": "collection_panel",
        "anchor_from": "center",
        "anchor_to": "center",
        "size": [162, 72],
        "offset": [-10, -40],
        "collection_name": "container_items",
        "$item_collection_name": "container_items",
        "controls": [
            {
                "machine_name@uc.machine_name": {
                    "offset": [0, -2]
                }
            },
            {
                "energy_bar@uc.energy_bar": {
                    "$collection_index": 0,
                    "$has_bg": false,
                    "offset": [-74, -1]
                }
            },
            {
                "side_panel@uc.machine_side_panel": {}
            },
            {
                "item_label@uc.text_label": {
                    "collection_index": 1,
                    "anchor_from": "top_left",
                    "anchor_to": "top_left",
                    "size": [74, 146],
                    "$text_scale": 0.55,
                    "offset": [-76, 2]
                }
            },
            {
                "input_grid@uc.slot_grid_2x2": {
                    "anchor_from": "top_middle",
                    "anchor_to": "top_middle",
                    "offset": [-26, 21],
                    "$slot_outline_texture": "textures/ui/slots/input_slot",
                    "$collection_index_1": 3,
                    "$collection_index_2": 4,
                    "$collection_index_3": 5,
                    "$collection_index_4": 6
                }
            },
            {
                "process_progress@uc.progress_display": {
                    "anchor_from": "top_middle",
                    "anchor_to": "top_middle",
                    "offset": [10, 22],
                    "collection_index": 2
                }
            },
            {
                "mode_button@uc.machine_button": {
                    "anchor_from": "top_middle",
                    "anchor_to": "top_middle",
                    "offset": [10, 52],
                    "$index": 8,
                    "$button_size": [16, 16],
                    "$default_texture": "textures/ui/cells/inverted_orange_cell_image",
                    "$hover_texture": "textures/ui/cells/orange_cell_image",
                    "$pressed_texture": "textures/ui/cells/orange_cell_image"
                }
            },
            {
                "output_grid@uc.slot_grid_2x2": {
                    "anchor_from": "top_middle",
                    "anchor_to": "top_middle",
                    "offset": [46, 21],
                    "$slot_outline_texture": "textures/ui/slots/output_slot",
                    "$collection_index_1": 16,
                    "$collection_index_2": 17,
                    "$collection_index_3": 18,
                    "$collection_index_4": 19
                }
            },
            {
                "upgrades_tab@uc.upgrades_tab": {
                    "$upgrade_index_1": 10,
                    "$upgrade_index_2": 11,
                    "$upgrade_index_3": 12,
                    "$upgrade_index_4": 13,
                    "$has_first_upgrade": true,
                    "$has_second_upgrade": true,
                    "$has_third_upgrade": true,
                    "$has_fourth_upgrade": true,
                    "$upgrade_overlay_1": "textures/items/machinery/speed_upgrade",
                    "$upgrade_overlay_2": "textures/items/machinery/energy_upgrade",
                    "$upgrade_overlay_3": "textures/items/machinery/hyper_processing_upgrade",
                    "$upgrade_overlay_4": "textures/items/machinery/quantity_upgrade"
                }
            },
            {
                "io_tab@uc.io_tab": {
                    "$io_items_modes_description": "ui.utilitycraft:io.arc_press_forge.items",
                    "$has_item_io": true,
                    "$has_fluid_io": false,
                    "$io_items_default": true,
                    "$io_top_texture": "textures/blocks/machines/superior/arc_press_forge_off_up",
                    "$io_left_texture": "textures/blocks/machines/superior/arc_press_forge_off_west",
                    "$io_front_texture": "textures/blocks/machines/superior/arc_press_forge_off_north",
                    "$io_right_texture": "textures/blocks/machines/superior/arc_press_forge_off_east",
                    "$io_bottom_texture": "textures/blocks/machines/superior/arc_press_forge_off_down",
                    "$io_back_texture": "textures/blocks/machines/superior/arc_press_forge_off_south",
                    "$io_item_top_index": 20,
                    "$io_item_left_index": 21,
                    "$io_item_front_index": 22,
                    "$io_item_right_index": 23,
                    "$io_item_bottom_index": 24,
                    "$io_item_back_index": 25
                }
            },
            {
                "info_tab@uc.info_tab": {
                    "$info_description": "ui.utilitycraft:info.arc_press_forge"
                }
            }
        ]
    },
    "utility_panel": {
