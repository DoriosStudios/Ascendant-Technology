{
    "namespace": "at_common",
    "_panel_surface@at_core.surface": {
        "texture": "$panel_texture"
    },
    "_slot_surface@at_core.surface": {
        "texture": "$slot_texture"
    },
    "panel": {
        "type": "panel",
        "$panel_size|default": [
            176,
            166
        ],
        "size": "$panel_size",
        "$background_ref|default": "at_common._panel_surface",
        "$content_ref|default": "common.empty_panel",
        "$show_close|default": false,
        "$close_button_ref|default": "common.close_button",
        "controls": [
            {
                "background@$background_ref": {
                    "size": [
                        "100%",
                        "100%"
                    ],
                    "layer": 0
                }
            },
            {
                "content@$content_ref": {
                    "layer": 1
                }
            },
            {
                "close@$close_button_ref": {
                    "visible": "$show_close",
                    "ignored": "(not $show_close)",
                    "anchor_from": "top_right",
                    "anchor_to": "top_right",
                    "offset": [
                        -4,
                        4
                    ],
                    "layer": 2
                }
            }
        ],
        "$panel_texture|default": "textures/ui/panels/background_panel"
    },
    "dark_panel@at_core.surface": {
        "$texture": "textures/ui/panels/background_panel_dark"
    },
    "blue_panel@at_core.surface": {
        "$texture": "textures/ui/panels/background_panel_blue"
    },
    "info_panel": {
        "type": "collection_panel",
        "collection_name": "container_items",
        "$item_collection_name": "container_items",
        "$bg_size|default": [
            90,
            166
        ],
        "$info_size|default": [
            "100% - 8px",
            "100% - 8px"
        ],
        "$text_borders|default": [
            "100% - 16px",
            "100% - 16px"
        ],
        "$has_bg|default": true,
        "$has_text|default": false,
        "$has_scroll|default": false,
        "$content_ref|default": "at_common.info_text",
        "$label_index|default": 1,
        "$text_scale|default": 0.55,
        "$text_color|default": [
            0,
            1,
            0
        ],
        "$background_ref|default": "at_common._panel_surface",
        "$show_close|default": false,
        "$close_button_ref|default": "common.close_button",
        "size": "$bg_size",
        "controls": [
            {
                "background@$background_ref": {
                    "size": "$bg_size",
                    "visible": "$has_bg",
                    "layer": 1
                }
            },
            {
                "screen": {
                    "type": "image",
                    "texture": "textures/ui/panels/panel_classic_borderless",
                    "size": "$info_size",
                    "layer": 2
                }
            },
            {
                "info@at_core.collection_text": {
                    "collection_index": "$label_index",
                    "size": "$text_borders",
                    "visible": "$has_text",
                    "layer": 5,
                    "$text_scale": "$text_scale",
                    "$text_color": "$text_color"
                }
            },
            {
                "info_scroll@common.scrolling_panel": {
                    "anchor_from": "center",
                    "anchor_to": "center",
                    "size": ["100%", "100% - 14px"],
                    "offset": [4, 0],
                    "layer": 6,
                    "ignored": "(not $has_scroll)",
                    "$scrolling_content": "$content_ref",
                    "$show_background": false,
                    "$scroll_size": [4, "100% - 4px"],
                    "$scrolling_pane_size": ["100%", "100%"],
                    "$scrolling_pane_offset": [0, 0],
                    "$scroll_view_port_size": ["100% - 16px", "100%"],
                    "$scroll_view_port_max_size": ["100% - 16px", "100%"],
                    "$scroll_view_port_offset": [0, 0],
                    "$scroll_size_touch": [4, "100% - 4px"],
                    "$scrolling_pane_size_touch": ["100%", "100%"],
                    "$scroll_view_port_size_touch": ["100% - 16px", "100%"],
                    "$scroll_view_port_max_size_touch": ["100% - 16px", "100%"],
                    "$scroll_view_port_offset_touch": [0, 0],
                    "$scroll_box_visible_touch": true,
                    "$scroll_track_image_control": "common.empty_image"
                }
            },
            {
                "close@$close_button_ref": {
                    "visible": "$show_close",
                    "ignored": "(not $show_close)",
                    "anchor_from": "top_right",
                    "anchor_to": "top_right",
                    "offset": [
                        -4,
                        4
                    ],
                    "layer": 7
                }
            }
        ],
        "$panel_texture|default": "textures/ui/panels/background_panel"
    },
    "scroll_panel@common.scrolling_panel": {
        "$content_ref|default": "common.empty_panel",
        "$scrolling_content": "$content_ref",
        "$show_background": false,
        "$scroll_size": [
            4,
            "100% - 4px"
        ],
        "$scroll_size_touch": [
            4,
            "100% - 4px"
        ],
        "$scroll_view_port_size|default": [
            "100% - 16px",
            "100%"
        ],
        "$scroll_view_port_max_size|default": [
            "100% - 16px",
            "100%"
        ],
        "$scroll_view_port_size_touch|default": [
            "100% - 16px",
            "100%"
        ],
        "$scroll_view_port_max_size_touch|default": [
            "100% - 16px",
            "100%"
        ],
        "$scroll_box_visible_touch": true,
        "$scroll_track_image_control": "common.empty_image"
    },
    "scrollable_info_panel@at_common.info_panel": {
        "$has_scroll": true
    },
    "info_text": {
        "type": "stack_panel",
        "orientation": "vertical",
        "anchor_from": "top_left",
        "anchor_to": "top_left",
        "size": [
            "100%",
            "default"
        ],
        "$label_index|default": 1,
        "$text_scale|default": 0.55,
        "$text_color|default": [
            0,
            1,
            0
        ],
        "controls": [
            {
                "top_padding": {
                    "type": "panel",
                    "size": [
                        "100%",
                        4
                    ]
                }
            },
            {
                "label_collection": {
                    "type": "collection_panel",
                    "collection_name": "container_items",
                    "anchor_from": "top_left",
                    "anchor_to": "top_left",
                    "size": [
                        "100%",
                        "100%c"
                    ],
                    "controls": [
                        {
                            "label@uc.text_label": {
                                "collection_index": "$label_index",
                                "anchor_from": "top_left",
                                "anchor_to": "top_left",
                                "size": [
                                    "100% - 8px",
                                    "100%c"
                                ],
                                "offset": [
                                    4,
                                    0
                                ],
                                "$text_scale": "$text_scale",
                                "layer": 1,
                                "controls": [
                                    {
                                        "label_v1@uc._text_label_v1": {
                                            "anchor_from": "top_left",
                                            "anchor_to": "top_left",
                                            "size": ["100%", "default"],
                                            "text_alignment": "left",
                                            "color": "$text_color"
                                        }
                                    },
                                    {
                                        "label_v2@uc._text_label_v2": {
                                            "anchor_from": "top_left",
                                            "anchor_to": "top_left",
                                            "size": ["100%", "default"],
                                            "text_alignment": "left",
                                            "color": "$text_color"
                                        }
                                    }
                                ]
                            }
                        }
                    ]
                }
            },
            {
                "bottom_padding": {
                    "type": "panel",
                    "size": [
                        "100%",
                        4
                    ]
                }
            }
        ]
    },
    "energy_display@at_core.resource_display": {
        "$hover_size|default": [
            16,
            50
        ],
        "$renderer_size|default": [
