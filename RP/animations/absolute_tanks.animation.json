{
    "format_version": "1.8.0",
    "animations": {
        "animation.ascendant_absolute_fluid_tank.fill": {
            "loop": true,
            "bones": {
                "fluid": {
                    "scale": [1, "query.property('ascendant:fill_level')", 1]
                }
            }
        },
        "animation.ascendant_absolute_gas_tank.fill": {
            "loop": true,
            "bones": {
                "gas": {
                    "scale": [1, "query.property('ascendant:fill_level')", 1]
                }
            }
        }
    }
}
