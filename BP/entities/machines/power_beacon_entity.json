                "always_show": false,
                "allow_name_tag_renaming": false
            },
            "minecraft:type_family": {
                "family": [
                    "inanimate",
                    "dorios:machine",
                    "dorios:energy_source",
                    "dorios:energy_container",
                    "dorios:container"
