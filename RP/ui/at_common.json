    "_slot_highlight": {
        "type": "panel",
        "size": ["100%", "100%"],
        "controls": [
            { "surface@at_core.surface": { "$texture": "$slot_hover_texture", "layer": 0 } },
            { "native@common.highlight_slot_panel": {} }
        ]
    },
    "slot@at_core.slot": {
        "$slot_texture|default": "",
        "$slot_hover_texture|default": "",
        "variables": [
            {
                "requires": "(not ($slot_texture = ''))",
                "$background_ref": "at_common._slot_surface"
            },
            {
                "requires": "(not ($slot_hover_texture = ''))",
                "$highlight_control": "at_common._slot_highlight"
            }
        ]
    },
    "input_slot@at_common.slot": {
        "$outline_texture|default": "textures/ui/slots/input_1_slot"
    },
    "output_slot@at_common.slot": {
        "size": [
            26,
            26
        ],
        "$outline_texture|default": "textures/ui/slots/output_1_slot"
    },
    "upgrade_slot@at_common.slot": {
        "$slot_texture|default": "textures/ui/cells/orange_cell_image"
    },
    "progress_arrow@at_core.item": {
        "$panel_size|default": [
            34,
            34
        ],
        "$renderer_size|default": [
            32,
            32
        ]
    },
    "grid_2x2": {
