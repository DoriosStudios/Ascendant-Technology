{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "utilitycraft:blastling",
      "materials": {
        "default": "skeleton"
      },
      "textures": {
        "default": "textures/entity/mobs/blastling"
      },
      "geometry": {
        "default": "geometry.utilitycraft_blastling"
      },
      "scripts": {
        "pre_animation": [
          "variable.tcos0 = (Math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed / variable.gliding_speed_value) * 28.65;"
        ],
        "animate": [
          {
            "walk": "query.modified_move_speed > 0.03 && !query.is_charged"
          },
          {
            "mad": "query.has_target && (query.is_charged || query.modified_move_speed <= 0.03)"
          },
          {
            "idle": "!query.has_target && query.modified_move_speed <= 0.03"
          }
        ]
      },
      "animations": {
        "walk": "animation.utilitycraft_blastling.walk",
        "idle": "animation.utilitycraft_blastling.idle",
        "mad": "animation.utilitycraft_blastling.mad"
      },
      "render_controllers": [
        "controller.render.default"
      ],
      "spawn_egg": {
        "texture": "utilitycraft:blastling",
        "texture_index": 0
      }
    }
  }
}
