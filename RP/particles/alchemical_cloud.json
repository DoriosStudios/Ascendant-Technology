{
    "format_version": "1.10.0",
    "particle_effect": {
        "description": {
            "identifier": "ascendant:alchemical_cloud",
            "basic_render_parameters": {
                "material": "particles_alpha",
                "texture": "textures/particle/particles"
            }
        },
        "components": {
            "minecraft:emitter_rate_instant": {
                "num_particles": "math.clamp(math.ceil(math.pi * variable.cloud_radius * variable.cloud_radius * 2), 4, 64)"
            },
            "minecraft:emitter_lifetime_once": {
                "active_time": 0.1
            },
            "minecraft:emitter_shape_disc": {
                "radius": "variable.cloud_radius",
                "direction": [0, 1, 0]
            },
            "minecraft:particle_lifetime_expression": {
                "max_lifetime": "math.random(0.85, 1.25)"
            },
            "minecraft:particle_initial_speed": "math.random(0.08, 0.22)",
            "minecraft:particle_motion_dynamic": {
                "linear_acceleration": [0, 0.06, 0],
                "linear_drag_coefficient": 0.4
            },
            "minecraft:particle_appearance_billboard": {
                "size": [
                    "0.09 + variable.particle_random_1 * 0.04",
                    "0.09 + variable.particle_random_1 * 0.04"
                ],
                "facing_camera_mode": "lookat_xyz",
                "uv": {
                    "texture_width": 128,
                    "texture_height": 128,
                    "flipbook": {
                        "base_UV": [64, 64],
                        "size_UV": [8, 8],
                        "step_UV": [-8, 0],
                        "frames_per_second": 8,
                        "max_frame": 8,
                        "stretch_to_lifetime": true
                    }
                }
            },
            "minecraft:particle_appearance_lighting": {},
            "minecraft:particle_appearance_tinting": {
                "color": [
                    "variable.color.r",
                    "variable.color.g",
                    "variable.color.b",
                    "variable.color.a * math.clamp((1 - variable.particle_age / variable.particle_lifetime) * 2, 0, 1)"
                ]
            }
        }
    }
}
