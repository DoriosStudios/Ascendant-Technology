{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "utilitycraft:endersent",
      "textures": {
        "default": "textures/entity/mobs/endersent"
      },
      "materials": {
        "default": "skeleton"
      },
      "geometry": {
        "default": "geometry.utilitycraft_endersent"
      },
      "render_controllers": [
        "controller.render.default"
      ],
      "spawn_egg": {
        "texture": "utilitycraft:endersent",
        "texture_index": 0
      },
      "animations": {
        "walk": "animation.utilitycraft_endersent.walk",
        "idle": "animation.utilitycraft_endersent.idle",
        "attack": "animation.utilitycraft_endersent.attack"
      },
      "scripts": {
        "animate": [
          {
            "attack": "query.property('utilitycraft:endersent_attack_state') > 0"
          },
          {
            "walk": "query.property('utilitycraft:endersent_attack_state') == 0 && query.modified_move_speed > 0.03"
          },
          {
            "idle": "query.property('utilitycraft:endersent_attack_state') == 0 && query.modified_move_speed <= 0.03"
          }
        ]
      }
    }
  }
}