            },
            { "energy_bar@uc.energy_bar": { "$collection_index": 0, "offset": [119, 64], "$bar_bg_texture": "textures/ui/toggle_button/right_bg" } },
            {
                "upgrades_tab@uc.upgrades_tab": {
                    "offset": [22, 0],
