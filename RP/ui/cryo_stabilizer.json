{
    "namespace": "cryo_stabilizer",
    "cryo_stabilizer_top": {
        "type": "collection_panel",
        "anchor_from": "center",
        "anchor_to": "center",
        "size": [162, 72],
        "offset": [-10, -40],
        "collection_name": "container_items",
        "$item_collection_name": "container_items",
        "controls": [
            {
                "screen": {
                    "type": "image",
                    "texture": "textures/ui/background_panel",
                    "anchor_from": "center",
                    "anchor_to": "center",
                    "$cell_image_size": [200, 166],
                    "size": [200, 166],
                    "offset": [20, 40],
                    "layer": -1
                }
            },
            {
                "exit_button_panel": {
                    "type": "panel", "anchor_from": "top_right", "anchor_to": "top_right", "offset": [42, -10],
                    "controls": [{ "close_button@common.close_button": {} }]
                }
            },
            { "machine_name@uc.machine_name": { "offset": [0, -2] } },
            { "side_panel@uc.machine_side_panel": { "offset": [-2, 0] } },
            {
                "item_label@uc.text_label": {
                    "collection_index": 1,
                    "anchor_from": "top_left", "anchor_to": "top_left",
                    "size": [74, 146], "$text_scale": 0.55, "offset": [-78, 2]
                }
            },
            {
                "input_grid@uc.slot_grid_2x2": {
                    "anchor_from": "top_middle", "anchor_to": "top_middle", "offset": [-35, 20],
                    "$slot_outline_texture": "textures/ui/slots/input_1_slot",
                    "$collection_index_1": 3, "$collection_index_2": 4,
                    "$collection_index_3": 5, "$collection_index_4": 6
                }
            },
            {
                "process_progress@uc.progress_display": {
                    "anchor_from": "top_middle", "anchor_to": "top_middle", "offset": [8, 22], "collection_index": 2
                }
            },
            {
                "output_grid@uc.slot_grid_2x2": {
                    "anchor_from": "top_middle", "anchor_to": "top_middle", "offset": [51, 20],
                    "$slot_outline_texture": "textures/ui/slots/output_slot",
                    "$collection_index_1": 12, "$collection_index_2": 13,
                    "$collection_index_3": 14, "$collection_index_4": 15
                }
            },
            { "energy_bar@uc.energy_bar": { "$collection_index": 0, "offset": [119, 64], "$bar_bg_texture": "textures/ui/toggle_button/right_bg" } },
            { "cryofluid_bar@uc.liquid_input_1_bar": { "$collection_index": 7, "$has_bg": false, "offset": [91, 64] } },
            {
                "upgrades_tab@uc.upgrades_tab": {
                    "offset": [22, 0],
                    "$upgrade_index_1": 8, "$upgrade_index_2": 9, "$upgrade_index_3": 10, "$upgrade_index_4": 11,
                    "$has_first_upgrade": true, "$has_second_upgrade": true,
                    "$has_third_upgrade": true, "$has_fourth_upgrade": true,
                    "$upgrade_overlay_1": "textures/items/machinery/speed_upgrade",
                    "$upgrade_overlay_2": "textures/items/machinery/energy_upgrade",
                    "$upgrade_overlay_3": "textures/items/machinery/hyper_processing_upgrade",
                    "$upgrade_overlay_4": "textures/items/machinery/stack_upgrade"
                }
            },
            {
                "io_tab@uc.io_tab": {
                    "offset": [22, 0],
                    "$io_items_modes_description": "ui.utilitycraft:io.cryo_stabilizer.items",
                    "$io_fluids_modes_description": "ui.utilitycraft:io.cryo_stabilizer.liquids",
                    "$has_item_io": true, "$has_fluid_io": true, "$has_gas_io": false,
                    "$io_items_default": true, "$io_fluids_default": false,
                    "$io_top_texture": "textures/blocks/machines/superior/cryo_stabilizer_off_up",
                    "$io_left_texture": "textures/blocks/machines/superior/cryo_stabilizer_off_west",
                    "$io_front_texture": "textures/blocks/machines/superior/cryo_stabilizer_off_north",
                    "$io_right_texture": "textures/blocks/machines/superior/cryo_stabilizer_off_east",
                    "$io_bottom_texture": "textures/blocks/machines/superior/cryo_stabilizer_off_down",
                    "$io_back_texture": "textures/blocks/machines/superior/cryo_stabilizer_off_south",
                    "$io_item_top_index": 16, "$io_item_left_index": 17, "$io_item_front_index": 18,
                    "$io_item_right_index": 19, "$io_item_bottom_index": 20, "$io_item_back_index": 21,
                    "$io_fluid_top_index": 22, "$io_fluid_left_index": 23, "$io_fluid_front_index": 24,
                    "$io_fluid_right_index": 25, "$io_fluid_bottom_index": 26, "$io_fluid_back_index": 27
                }
            },
            { "info_tab@uc.info_tab": { "offset": [22, 0], "$info_description": "ui.utilitycraft:info.cryo_stabilizer" } }
        ]
    },
    "utility_panel": {
        "type": "panel",
        "controls": [
            { "container_gamepad_helpers@common.container_gamepad_helpers": {} },
            { "flying_item_renderer@common.flying_item_renderer": { "layer": 40 } },
            { "selected_item_details_factory@common.selected_item_details_factory": {} },
            { "item_lock_notification_factory@common.item_lock_notification_factory": {} },
            {
                "root_panel@common.root_panel": {
                    "layer": 1,
                    "controls": [
                        { "common_panel@common.common_panel": { "$show_close_button": false } },
                        {
                            "chest_panel": {
                                "type": "panel", "layer": 5,
                                "controls": [
                                    { "cryo_stabilizer_top@cryo_stabilizer.cryo_stabilizer_top": {} },
                                    { "inventory_panel_bottom_half_with_label@common.inventory_panel_bottom_half_with_label": {} },
                                    { "hotbar_grid@common.hotbar_grid_template": {} },
                                    { "inventory_take_progress_icon_button@common.inventory_take_progress_icon_button": {} }
                                ]
                            }
                        },
                        { "inventory_selected_icon_button@common.inventory_selected_icon_button": {} },
                        { "gamepad_cursor@common.gamepad_cursor_button": {} }
                    ]
                }
            }
        ]
    }
}
