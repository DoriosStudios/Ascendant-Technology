{
    "format_version": "1.19.20",
    "minecraft:entity": {
        "description": {
            "identifier": "utilitycraft:power_beacon_entity",
            "is_spawnable": false,
            "is_summonable": true,
            "is_experimental": false,
            "properties": {
                "utilitycraft:players": {
                    "type": "int",
                    "default": 0,
