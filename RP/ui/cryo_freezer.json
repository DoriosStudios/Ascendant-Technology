                    "$has_first_upgrade": true, "$has_second_upgrade": true,
                    "$has_third_upgrade": false, "$has_fourth_upgrade": false,
                    "$upgrade_overlay_1": "textures/items/machinery/speed_upgrade",
                    "$upgrade_overlay_2": "textures/items/machinery/energy_upgrade"
                }
            },
            {
                "io_tab@uc.io_tab": {
                    "offset": [22, 0],
                    "$io_items_modes_description": "ui.utilitycraft:io.cryo_freezer.items",
                    "$io_fluids_modes_description": "ui.utilitycraft:io.cryo_freezer.liquids",
                    "$has_item_io": true, "$has_fluid_io": true, "$has_gas_io": false,
                    "$io_items_default": true, "$io_fluids_default": false,
                    "$io_top_texture": "textures/blocks/machines/superior/cryo_freezer_off_up",
                    "$io_left_texture": "textures/blocks/machines/superior/cryo_freezer_off_west",
                    "$io_front_texture": "textures/blocks/machines/superior/cryo_freezer_off_north",
                    "$io_right_texture": "textures/blocks/machines/superior/cryo_freezer_off_east",
                    "$io_bottom_texture": "textures/blocks/machines/superior/cryo_freezer_off_down",
                    "$io_back_texture": "textures/blocks/machines/superior/cryo_freezer_off_south",
                    "$io_item_top_index": 20, "$io_item_left_index": 21, "$io_item_front_index": 22,
                    "$io_item_right_index": 23, "$io_item_bottom_index": 24, "$io_item_back_index": 25,
                    "$io_fluid_top_index": 26, "$io_fluid_left_index": 27, "$io_fluid_front_index": 28,
                    "$io_fluid_right_index": 29, "$io_fluid_bottom_index": 30, "$io_fluid_back_index": 31
                }
            },
            { "info_tab@uc.info_tab": { "offset": [22, 0], "$info_description": "ui.utilitycraft:info.cryo_freezer" } }
        ]
