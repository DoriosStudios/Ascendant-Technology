                    ],
                    "size": "$cell_size",
                    "collection_index": "$slot_index_0",
                    "$slot_index": "$slot_index_0"
                }
            },
            {
                "slot_1@$slot_control": {
                    "anchor_from": "top_left",
                    "anchor_to": "top_left",
                    "offset": [
                        18,
