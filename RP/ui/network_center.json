{
    "namespace": "network_center",
    "page@at_common.tab_content": {
        "anchor_from": "top_left",
        "anchor_to": "top_left",
        "offset": [
            6,
            16
        ],
        "size": [
            "100% - 12px",
            "100% - 31px"
        ],
        "$page_content|default": "network_center.overview_content",
        "controls": [
            {
                "background": {
                    "type": "image",
                    "texture": "textures/ui/panels/panel_classic_borderless",
                    "size": [
                        "100%",
                        "100%"
                    ],
                    "layer": 1
                }
            },
            {
                "scroll@at_common.scroll_panel": {
                    "anchor_from": "top_left",
                    "anchor_to": "top_left",
                    "offset": [
                        2,
                        3
                    ],
                    "size": [
                        "100% - 4px",
                        "100% - 4px"
                    ],
                    "$content_ref": "$page_content",
                    "layer": 3
                }
            },
            {
                "header": {
                    "type": "stack_panel",
                    "orientation": "horizontal",
                    "anchor_from": "top_right",
                    "anchor_to": "top_right",
                    "offset": [
                        -1,
                        -14
                    ],
                    "size": [
                        "100%c",
                        12
                    ],
                    "layer": 6,
                    "controls": [
                        {
                            "page_title": {
                                "type": "label",
                                "text": "$page_title",
                                "localize": true,
                                "anchor_from": "bottom_left",
                                "anchor_to": "bottom_left",
                                "offset": [
                                    0,
                                    2
                                ],
                                "size": [
                                    "default",
                                    12
                                ],
                                "font_scale_factor": 0.7,
                                "color": [
                                    0.8,
                                    0.87,
                                    0.96
                                ],
                                "layer": 2
                            }
                        },
                        {
                            "gap": {
                                "type": "panel",
                                "size": [
                                    4,
                                    12
                                ]
                            }
                        },
                        {
                            "next_page": {
                                "type": "collection_panel",
                                "collection_name": "container_items",
                                "size": [
                                    "100%c",
                                    12
                                ],
                                "controls": [
                                    {
                                        "button@common_buttons.light_text_form_fitting_button": {
                                            "collection_index": "$page_slot",
                                            "size": [
                                                "100%c",
                                                12
                                            ],
                                            "$pressed_button_name": "button.drop_all",
                                            "$button_bindings": [
                                                {
                                                    "binding_type": "collection_details",
                                                    "binding_collection_name": "container_items"
                                                }
                                            ],
                                            "$button_text": "ui.ascendant:network.nextPage",
                                            "$button_font_scale_factor": 0.55,
                                            "$default_button_texture": "textures/ui/button_card/button_light_blue",
                                            "$hover_button_texture": "textures/ui/button_card/button_light_blue_hover",
                                            "$pressed_button_texture": "textures/ui/button_card/button_light_blue_pressed",
                                            "$default_text_color": [
                                                0.08,
                                                0.09,
                                                0.15
                                            ],
                                            "$hover_text_color": [
                                                0.08,
                                                0.09,
                                                0.15
                                            ],
                                            "$pressed_text_color": [
                                                0.08,
                                                0.09,
                                                0.15
                                            ],
                                            "$button_size_override": [
                                                "100%c",
                                                12
                                            ],
                                            "$focus_border_size_override": [
                                                "100%c",
                                                12
                                            ],
                                            "$button_image_size_override": [
                                                "100%c",
                                                12
                                            ],
                                            "$button_content_size_override": [
                                                "100%c + 12px",
                                                12
                                            ],
                                            "$button_offset": [
                                                6,
                                                3
                                            ],
                                            "$button_pressed_offset": [
                                                6,
                                                3
                                            ],
                                            "layer": 6,
                                            "$button_text_max_size": [
                                                128,
                                                10
                                            ],
                                            "$button_type_panel": "network_center.page_button_label"
                                        }
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        ],
        "$page_slot|default": 0,
        "bindings": [
            {
                "binding_type": "view",
                "source_control_name": "$tab_control",
                "source_property_name": "#toggle_state",
                "target_property_name": "#visible",
                "resolve_sibling_scope": false
            }
        ],
        "$page_title|default": "ui.ascendant:network.overview"
    },
    "utility_panel": {
        "type": "panel",
        "controls": [
            {
                "container_gamepad_helpers@common.container_gamepad_helpers": {}
            },
            {
                "selected_item_details_factory@common.selected_item_details_factory": {}
            },
            {
                "item_lock_notification_factory@common.item_lock_notification_factory": {}
            },
            {
                "root_panel@common.root_panel": {
                    "size": [
                        "100%",
                        "100%"
                    ],
                    "controls": [
                        {
                            "dashboard": {
                                "type": "panel",
                                "size": [
                                    "100% - 16px",
                                    "100% - 43px"
                                ],
                                "max_size": [
                                    250,
                                    166
                                ],
                                "controls": [
                                    {
                                        "background": {
                                            "type": "image",
                                            "texture": "textures/ui/panels/background_panel_dark",
                                            "size": [
                                                "100%",
                                                "100%"
                                            ],
                                            "layer": 0
                                        }
                                    },
                                    {
                                        "title_row": {
                                            "type": "panel",
                                            "anchor_from": "top_left",
                                            "anchor_to": "top_left",
                                            "offset": [
                                                8,
                                                2
                                            ],
                                            "size": [
                                                "100% - 16px",
                                                12
                                            ],
                                            "controls": [
                                                {
                                                    "title": {
                                                        "type": "label",
                                                        "text": "ui.ascendant:network.title",
                                                        "localize": true,
                                                        "anchor_from": "left_middle",
                                                        "anchor_to": "left_middle",
                                                        "offset": [
                                                            0,
                                                            2
                                                        ],
                                                        "size": [
                                                            "default",
                                                            "default"
                                                        ],
                                                        "font_scale_factor": 0.9,
                                                        "color": [
                                                            0.86,
                                                            0.95,
                                                            1
                                                        ],
                                                        "layer": 2
                                                    }
                                                }
                                            ]
                                        }
                                    },
                                    {
                                        "view_top_bar@network_center.view_top_bar": {}
                                    },
                                    {
                                        "overview_page@network_center.page": {
                                            "$tab_control": "overview_tab",
                                            "$page_content": "network_center.overview_content",
                                            "$page_slot": 0,
                                            "$page_title": "ui.ascendant:network.overview"
                                        }
                                    },
                                    {
                                        "gains_page@network_center.page": {
                                            "$tab_control": "gains_tab",
                                            "$page_content": "network_center.gains_content",
                                            "$page_slot": 1,
                                            "$page_title": "ui.ascendant:network.gains"
                                        }
                                    },
                                    {
                                        "losses_page@network_center.page": {
                                            "$tab_control": "losses_tab",
                                            "$page_content": "network_center.losses_content",
                                            "$page_slot": 2,
                                            "$page_title": "ui.ascendant:network.losses"
                                        }
                                    },
                                    {
                                        "capacity_page@network_center.page": {
                                            "$tab_control": "capacity_tab",
                                            "$page_content": "network_center.capacity_content",
                                            "$page_slot": 3,
                                            "$page_title": "ui.ascendant:network.capacity"
                                        }
                                    },
                                    {
                                        "status@network_center.status_text": {
                                            "anchor_from": "bottom_left",
                                            "anchor_to": "bottom_left",
                                            "offset": [
                                                6,
                                                -4
                                            ],
                                            "size": [
                                                "100% - 12px",
                                                10
                                            ],
                                            "$label_index": 4,
                                            "$text_scale": 0.55,
                                            "$text_color": [
                                                0.76,
                                                0.83,
                                                0.86
                                            ],
                                            "layer": 2
                                        }
                                    }
                                ],
                                "offset": [
                                    0,
                                    13
                                ]
                            }
                        }
                    ]
                }
            }
        ]
    },
    "button_card_buttons@at_core.button_card_row": {
        "controls": [
            {
                "overview_tab@at_common.card_tab": {
                    "$toggle_name": "network_center_pages",
