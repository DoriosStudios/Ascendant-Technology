	"side_view_top_bar@at_common.button_card": {
		"$card_buttons_ref": "alchemical_station.side_button_card_buttons",
		"$card_background_texture": "textures/ui/button_card/tab_top_brown",
		"anchor_from": "top_right",
		"anchor_to": "top_right",
		"$card_offset": [-22, 0],
		"$card_show_close": false,
		"$card_show_background": false
	},
	"brown_background": {
		"type": "image",
		"texture": "textures/ui/panels/background_panel_brown",
		"size": ["100%", "100%"],
		"layer": 1
	},
	"potion_slot_background": {
		"type": "panel",
		"size": ["100%", "100%"],
		"controls": [
			{
				"cell_image@common.cell_image": {
					"texture": "textures/ui/cells/brown_cell_image",
					"$cell_selected_binding_name|default": "#is_selected_slot",
					"visible": true,
					"bindings": [
						{
							"binding_name": "(not $cell_selected_binding_name)",
							"binding_name_override": "#visible",
							"binding_type": "collection",
							"binding_collection_name": "$item_collection_name"
						}
					]
				}
			},
			{
				"cell_image_selected@common.cell_image_selected": {
					"$cell_selected_binding_name|default": "#is_selected_slot",
					"visible": false,
					"bindings": [
						{
							"binding_name": "$cell_selected_binding_name",
							"binding_name_override": "#visible",
							"binding_type": "collection",
							"binding_collection_name": "$item_collection_name"
						}
					]
				}
			}
		]
	},
	"bottle_empty": {
		"type": "image",
		"texture": "textures/ui/bottle_empty",
		"size": [16, 16],
		"layer": 2,
		"bindings": [
			{
				"binding_name": "#item_id_aux",
				"binding_type": "collection",
				"binding_collection_name": "container_items"
			},
			{
				"binding_type": "view",
				"source_property_name": "(not (#item_id_aux > 0))",
				"target_property_name": "#visible"
			}
		]
	},
