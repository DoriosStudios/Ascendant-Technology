                    "$io_item_left_index": 18,
                    "$io_item_front_index": 19,
                    "$io_item_right_index": 20,
                    "$io_item_bottom_index": 21,
                    "$io_item_back_index": 22,
                    "$io_gas_top_index": 23,
                    "$io_gas_left_index": 24,
                    "$io_gas_front_index": 25,
                    "$io_gas_right_index": 26,
                    "$io_gas_bottom_index": 27,
                    "$io_gas_back_index": 28
